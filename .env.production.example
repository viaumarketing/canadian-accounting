# Production settings. scripts/install.sh asks for the values marked REQUIRED and generates the secrets.
# Never commit the resulting .env. Keep a copy somewhere other than the NAS (see docs/backup-and-recovery.md).

# --- REQUIRED: where the images come from (your GitHub user or organisation / repository, lower case) ---
GITHUB_REPOSITORY=
# --- REQUIRED: release to run, exactly as tagged (vX.Y.Z -> X.Y.Z) ---
APP_VERSION=

# --- REQUIRED: the name people type in the browser, without https:// (a private LAN name, e.g. one you add in your router's DNS) ---
SITE_ADDRESS=
# Ports Caddy publishes on the NAS. If 443/80 are already used by UGOS or another app, pick free ones (e.g. 8443/8080).
HTTPS_PORT=443
HTTP_PORT=80
# Set automatically by install.sh when HTTPS_PORT is not 443 (https://SITE_ADDRESS:HTTPS_PORT). The API checks it on every change.
WEB_ORIGIN=

# --- REQUIRED: absolute path of an EMPTY folder on a NAS data volume; postgres/, redis/, documents/, backups/, caddy/ go inside ---
DATA_DIR=

# --- Generated by install.sh: do not change after the first start ---
POSTGRES_USER=ca_admin
POSTGRES_DB=canadian_accounting
POSTGRES_PASSWORD=
ENCRYPTION_KEY=
BACKUP_PASSPHRASE=
# Needed once, to create the first administrator. Clear it (and restart api) afterwards.
SETUP_TOKEN=

# --- Backups ---
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_HOURS=24

# --- Background work (sized for an Intel N100 with 8 GB; raise only after watching System administration -> Resources) ---
WORKER_CONCURRENCY=1
SYNC_MAX_BACKLOG=20
BANK_MAX_PAGES_PER_RUN=40

# --- Optional integrations (see docs/shopify-setup.md and docs/banking-setup.md) ---
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REQUEST_ALL_ORDERS=false
SHOPIFY_WEBHOOK_BASE_URL=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
PLAID_REDIRECT_URI=
