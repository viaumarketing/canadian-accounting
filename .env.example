# Copy to .env and fill in. NEVER commit .env.
# Generate secrets with:  openssl rand -base64 32

NODE_ENV=development

# --- PostgreSQL (dev compose publishes it on 127.0.0.1 only) ---
POSTGRES_USER=ca_admin
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=canadian_accounting
DATABASE_URL=postgresql://ca_admin:change-me-dev-only@127.0.0.1:5432/canadian_accounting?schema=public

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379

# --- API ---
API_PORT=4000
# Public URL the browser uses for the web app (CORS/origin checks, cookie scope)
WEB_ORIGIN=http://localhost:3000
# 32 random bytes, base64. Encrypts TOTP secrets (and later, integration credentials).
ENCRYPTION_KEY=
# Optional: if set, first-administrator setup requires this token.
SETUP_TOKEN=

# --- Web ---
# Where the Next.js server proxies /api/* requests to
API_INTERNAL_URL=http://127.0.0.1:4000

# --- Shopify (create an app in the Shopify Dev Dashboard; see docs/shopify-setup.md) ---
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# true only if Shopify has granted read_all_orders (otherwise only the last 60 days are visible)
SHOPIFY_REQUEST_ALL_ORDERS=false
# Optional: public https URL Shopify can reach for webhooks. Leave empty on a private network; polling still works.
SHOPIFY_WEBHOOK_BASE_URL=

# --- Bank connections (optional; CSV/OFX import works without them). See docs/banking-setup.md ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Needed only for institutions that use OAuth sign-in; must be registered in the Plaid dashboard
PLAID_REDIRECT_URI=

# --- System administration ---
# Read-only mount of the backup folder (lets the admin console show backup age/size). In Docker this is /backups.
BACKUP_DIR=

# --- E-mail (Resend, https://resend.com; see docs/email.md). Without these the app cannot send e-mail and says so ---
RESEND_API_KEY=
# An address on a domain you verified in Resend, e.g. billing@mail.example.com
MAIL_FROM=

# --- Edition: selfhosted (your own companies, no billing) or saas (public sign-up and subscriptions; see docs/saas.md) ---
APP_MODE=selfhosted
APP_NAME=Canadian Accounting
# SaaS only: the platform's own Stripe account (each company's card payments use the company's own keys, entered in Settings)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_ESSENTIALS=
STRIPE_PRICE_PLUS=
SAAS_TRIAL_DAYS=30
